@inject MiChatbotBlazor.Services.IChatService ChatService
@inject NavigationManager Navigation
@inject SessionStateService SessionState

@if (showDeleteConfirm)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" @onclick="CancelDelete">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header border-secondary d-flex align-items-center justify-content-between p-3">
                <h5 class="modal-title m-0">Eliminar conversación</h5>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CancelDelete"></button>
            </div>

            <div class="modal-body p-3">
                <p>¿Seguro que deseas eliminar <strong>@sessionToDeleteTitle</strong>?</p>
                <small class="text-muted">Esta acción quitará la sesión de la lista.</small>
            </div>

            <div class="modal-footer border-secondary d-flex justify-content-end gap-2 p-3">
                <button class="btn btn-secondary" @onclick="CancelDelete">Cancelar</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">Eliminar</button>
            </div>
        </div>
    </div>
}

<!-- Mobile Topbar (solo móvil) -->
<div class="d-md-none bg-dark w-100 position-fixed top-0 start-0" style="z-index: 1050;">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom border-secondary">
        <span class="fs-5 fw-semibold text-white">Sesiones de Chat</span>
        <button class="btn btn-dark border-0" @onclick="ToggleNavMenu" type="button">
            <span class="text-white">
                @if (collapseNavMenu)
                {
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z" />
                    </svg>
                }
                else
                {
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                }
            </span>
        </button>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div class="@(collapseNavMenu ? "d-none" : "d-block") bg-dark border-top border-secondary" style="max-height: 70vh; overflow-y: auto;">
        <div class="list-group list-group-flush">
            @if (Sessions != null && Sessions.Any())
            {
                @foreach (var session in Sessions)
                {
                    <div class="list-group-item list-group-item-action py-3 lh-tight bg-dark text-light border-0 session-item"
                         style="border-bottom: 1px solid #495057 !important; cursor: pointer;"
                         @onclick="() => NavigateToSession(session.Id)">

                        <div class="d-flex w-100 align-items-start justify-content-between">
                            @if (editingSessionId == session.Id)
                            {
                                <div class="flex-grow-1 pe-2">
                                    <input class="form-control form-control-sm"
                                           @bind="editTitle" @bind:event="oninput"
                                           maxlength="80"
                                           @onkeydown="(e) => OnTitleKeyDown(e, session.Id)"
                                           @onblur="() => SaveTitle(session.Id)"
                                           placeholder="Título de la conversación" />
                                </div>
                                <div class="btn-group-vertical btn-group-xs gap-1">
                                    <button class="btn btn-success btn-sm"
                                            title="Guardar"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => SaveTitle(session.Id)">
                                        ✔
                                    </button>
                                    <button class="btn btn-secondary btn-sm"
                                            title="Cancelar"
                                            @onclick:stopPropagation="true"
                                            @onclick="CancelEdit">
                                        ✖
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="flex-grow-1 pe-2">
                                    <strong class="mb-1 text-white text-truncate d-block">@session.Title</strong>
                                    <small class="text-muted">@session.CreatedAt.ToString("MMM dd")</small>
                                </div>
                                <div class="btn-group-vertical btn-group-xs gap-1">
                                    <button class="btn btn-outline-light btn-sm"
                                            title="Renombrar"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => StartEdit(session.Id, session.Title)">
                                        ✏
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm"
                                            title="Eliminar"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenDeleteConfirm(session.Id, session.Title)">
                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 5h4a.5.5 0 0 1 .5.5V6h3a.5.5 0 0 1 0 1h-.538l-.853 7.669A2 2 0 0 1 9.123 16H6.877a2 2 0 0 1-1.986-1.331L4.038 7H3.5a.5.5 0 0 1 0-1H7v-.5A.5.5 0 0 1 7.5 5h1a.5.5 0 0 1 .5.5V6h-3v-.5z" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>


                        <div class="col-10 mb-1 small session-excerpt">
                            @if (session.Messages != null && session.Messages.Any())
                            {
                                var lastMessage = session.Messages.OrderByDescending(m => m.Timestamp).FirstOrDefault();
                                if (lastMessage != null)
                                {
                                    <span class="text-light">@(lastMessage.Content.Length > 60 ? lastMessage.Content[..60] + "..." : lastMessage.Content)</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Nueva conversación</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="list-group-item py-3 bg-dark border-0">
                    <div class="text-center text-muted">
                        <p class="mb-0">No hay sesiones de chat</p>
                        <small>Inicia una nueva conversación</small>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Desktop Sidebar (solo desktop) -->
<div class="d-none d-md-flex flex-column align-items-stretch flex-shrink-0 bg-dark h-100 position-relative" style="width: 280px; max-width: 380px;">
    <nav class="flex-column h-100">
        <a href="/" class="d-flex align-items-center flex-shrink-0 p-3 link-light text-decoration-none border-bottom border-secondary">
            <svg class="bi me-2" width="30" height="24"><use xlink:href="#bootstrap" /></svg>
            <span class="fs-5 fw-semibold text-white">Sesiones de Chat</span>
        </a>

        <div class="list-group list-group-flush border-bottom border-secondary flex-grow-1 overflow-auto" style="background: transparent;">
            @if (Sessions != null && Sessions.Any())
            {
                @foreach (var session in Sessions)
                {
                    <div class="list-group-item list-group-item-action py-3 lh-tight bg-dark text-light border-0"
                         style="border-bottom: 1px solid #495057 !important; cursor: pointer;"
                         @onclick="() => NavigateToSession(session.Id)">

                        <div class="d-flex w-100 align-items-start justify-content-between">
                            @if (editingSessionId == session.Id)
                            {
                                <div class="d-flex align-items-center gap-2 flex-grow-1 pe-2">
                                    <input class="form-control form-control-sm" style="max-width: 220px;"
                                           @bind="editTitle" @bind:event="oninput"
                                           maxlength="80"
                                           @onkeydown="(e) => OnTitleKeyDown(e, session.Id)"
                                           @onblur="() => SaveTitle(session.Id)"
                                           placeholder="Título de la conversación" />
                                </div>
                                <div class="btn-group-vertical btn-group-xs gap-1">
                                    <button class="btn btn-success btn-sm"
                                            title="Guardar"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => SaveTitle(session.Id)">
                                        ✔
                                    </button>
                                    <button class="btn btn-secondary btn-sm"
                                            title="Cancelar"
                                            @onclick:stopPropagation="true"
                                            @onclick="CancelEdit">
                                        ✖
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="flex-grow-1 pe-2">
                                    <strong class="mb-1 text-white text-truncate d-block">@session.Title</strong>
                                    <small class="text-muted">@session.CreatedAt.ToString("MMM dd")</small>
                                </div>
                                <div class="btn-group-vertical btn-group-xs gap-1">
                                    <button class="btn btn-outline-light btn-sm"
                                            title="Renombrar"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => StartEdit(session.Id, session.Title)">
                                        ✏
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm"
                                            title="Eliminar"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenDeleteConfirm(session.Id, session.Title)">
                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 5h4a.5.5 0 0 1 .5.5V6h3a.5.5 0 0 1 0 1h-.538l-.853 7.669A2 2 0 0 1 9.123 16H6.877a2 2 0 0 1-1.986-1.331L4.038 7H3.5a.5.5 0 0 1 0-1H7v-.5A.5.5 0 0 1 7.5 5h1a.5.5 0 0 1 .5.5V6h-3v-.5z" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>


                        <div class="col-10 mb-1 small">
                            @if (session.Messages != null && session.Messages.Any())
                            {
                                var lastMessage = session.Messages.OrderByDescending(m => m.Timestamp).FirstOrDefault();
                                if (lastMessage != null)
                                {
                                    <span class="text-light">@(lastMessage.Content.Length > 60 ? lastMessage.Content[..60] + "..." : lastMessage.Content)</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Nueva conversación</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="list-group-item py-3 lh-tight bg-dark border-0">
                    <div class="text-center text-muted">
                        <p class="mb-0">No hay sesiones de chat</p>
                        <small>Inicia una nueva conversación</small>
                    </div>
                </div>
            }
        </div>
    </nav>
</div>

@implements IDisposable

@code {
    private bool collapseNavMenu = true;
    private List<MiChatbotBlazor.Data.Models.ChatSession> Sessions { get; set; } = new();

    // Estado eliminar
    private bool showDeleteConfirm = false;
    private int? sessionToDeleteId = null;
    private string sessionToDeleteTitle = string.Empty;

    // Estado edición de título
    private int? editingSessionId = null;
    private string editTitle = string.Empty;
    private bool isSavingTitle = false;

    protected override async Task OnInitializedAsync()
    {
        SessionState.SessionsUpdated += OnSessionsUpdated;
        Sessions = await ChatService.GetChatsSessionsAsync("demo");
        StateHasChanged();
    }

    private async void OnSessionsUpdated()
    {
        Sessions = await ChatService.GetChatsSessionsAsync("demo");
        StateHasChanged();
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void NavigateToSession(int sessionId)
    {
        collapseNavMenu = true;
        SessionState.SetCurrentSession(sessionId);
        Navigation.NavigateTo($"/chat/{sessionId}");
        StateHasChanged();
    }

    // --- Edición de título ---
    private void StartEdit(int id, string currentTitle)
    {
        editingSessionId = id;
        editTitle = currentTitle;
    }

    private void CancelEdit()
    {
        editingSessionId = null;
        editTitle = string.Empty;
        isSavingTitle = false;
        StateHasChanged();
    }

    private async Task SaveTitle(int id)
    {
        if (isSavingTitle) return;

        var trimmed = (editTitle ?? string.Empty).Trim();

        // Evitar guardados inválidos o redundantes
        var current = Sessions.FirstOrDefault(s => s.Id == id);
        if (current == null) { CancelEdit(); return; }

        if (string.IsNullOrWhiteSpace(trimmed) || trimmed == current.Title)
        {
            CancelEdit();
            return;
        }

        try
        {
            isSavingTitle = true;
            await ChatService.UpdateSessionTitleAsync(id, trimmed);
            // Refrescar lista y notificar
            SessionState.NotifySessionsUpdated();
        }
        finally
        {
            CancelEdit();
        }
    }

    private async Task OnTitleKeyDown(KeyboardEventArgs e, int id)
    {
        if (e.Key is "Enter")
        {
            await SaveTitle(id);
        }
        else if (e.Key is "Escape")
        {
            CancelEdit();
        }
    }

    // --- Eliminar ---
    private void OpenDeleteConfirm(int id, string title)
    {
        sessionToDeleteId = id;
        sessionToDeleteTitle = title;
        showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        sessionToDeleteId = null;
        sessionToDeleteTitle = string.Empty;
    }

    private async Task ConfirmDelete()
    {
        if (sessionToDeleteId.HasValue)
        {
            await ChatService.DeleteSessionAsync(sessionToDeleteId.Value);
            Sessions = await ChatService.GetChatsSessionsAsync("demo");

            // Si estabas en esa sesión, ir al home
            var current = SessionState.CurrentSessionId;
            if (current == sessionToDeleteId.Value)
            {
                SessionState.SetCurrentSession(0);
                Navigation.NavigateTo("/");
            }
        }
        CancelDelete();
        StateHasChanged();
    }

    public void Dispose()
    {
        SessionState.SessionsUpdated -= OnSessionsUpdated;
    }
}

@inject MiChatbotBlazor.Services.IChatService ChatService
@inject NavigationManager Navigation
@inject SessionStateService SessionState
@implements IDisposable

@if (showDeleteConfirm)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" @onclick="CancelDelete">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header d-flex align-items-center justify-content-between p-3">
                <h5 class="modal-title m-0 fw-semibold">Eliminar conversación</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CancelDelete"></button>
            </div>

            <div class="modal-body p-4">
                <p class="mb-2">¿Seguro que deseas eliminar <strong>@sessionToDeleteTitle</strong>?</p>
                <small class="text-muted">Esta acción borrará definitivamente esta conversación y su historial.</small>
            </div>

            <div class="modal-footer d-flex justify-content-end gap-2 p-3">
                <button class="btn btn-outline-secondary" @onclick="CancelDelete">Cancelar</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">Eliminar</button>
            </div>
        </div>
    </div>
}

<div class="sidebar-container h-100">
    <!-- Header -->
    <div class="sidebar-header">
        <h2 class="sidebar-title">
            <i class="bi bi-chat-square-text-fill"></i>
            <span>Conversaciones</span>
        </h2>
        <button class="btn-sidebar-toggle-inner d-none d-md-flex" @onclick="OnToggleSidebar" title="Ocultar panel lateral">
            <i class="bi bi-layout-sidebar-inset-reverse"></i>
        </button>
    </div>

    <!-- Botón Nuevo Chat -->
    <div class="new-chat-container">
        <button class="btn btn-new-chat" @onclick="ClearChat">
            <i class="bi bi-plus-lg"></i>
            <span>Nuevo Chat</span>
        </button>
    </div>

    <!-- Lista de Chats -->
    <div class="sessions-list">
        @if (Sessions != null && Sessions.Any())
        {
            @foreach (var session in Sessions)
            {
                var isActive = session.Id == SessionState.CurrentSessionId;
                <div class="session-item @(isActive ? "active" : "")"
                     @onclick="() => NavigateToSession(session.Id)">
                    
                    <div class="session-icon">
                        <i class="bi bi-chat-left-text"></i>
                    </div>

                    <div class="session-details">
                        @if (editingSessionId == session.Id)
                        {
                            <div class="d-flex align-items-center gap-1" @onclick:stopPropagation="true">
                                <input class="session-edit-input"
                                       @bind="editTitle" @bind:event="oninput"
                                       maxlength="80"
                                       @onkeydown="(e) => OnTitleKeyDown(e, session.Id)"
                                       @onblur="() => SaveTitle(session.Id)"
                                       placeholder="Título" />
                                <button class="btn-action btn-save-edit" @onclick="() => SaveTitle(session.Id)" title="Guardar">
                                    <i class="bi bi-check"></i>
                                </button>
                                <button class="btn-action btn-cancel-edit" @onclick="CancelEdit" title="Cancelar">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <h4 class="session-title">@session.Title</h4>
                            <span class="session-date">@session.CreatedAt.ToString("MMM dd")</span>
                        }
                    </div>

                    @if (editingSessionId != session.Id)
                    {
                        <div class="session-actions" @onclick:stopPropagation="true">
                            <button class="btn-action" @onclick="() => StartEdit(session.Id, session.Title)" title="Renombrar">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn-action btn-delete" @onclick="() => OpenDeleteConfirm(session.Id, session.Title)" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-chat-dots fs-3 d-block mb-2 text-secondary"></i>
                <p class="mb-0 small">No hay sesiones de chat</p>
                <small class="x-small">Inicia una nueva conversación</small>
            </div>
        }
    </div>

    <!-- Footer -->
    <div class="sidebar-footer">
        <div class="user-profile">
            <img src="/images/user-avatar.png" alt="Usuario" class="user-avatar" />
            <div class="user-info">
                <span class="user-name">Usuario Demo</span>
                <span class="user-status">En línea</span>
            </div>
        </div>
        <button class="btn-action" title="Configuración">
            <i class="bi bi-gear-fill"></i>
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnCloseMobileSidebar { get; set; }
    [Parameter] public bool IsCollapsed { get; set; }

    private List<MiChatbotBlazor.Data.Models.ChatSession> Sessions { get; set; } = new();

    // Estado eliminar
    private bool showDeleteConfirm = false;
    private int? sessionToDeleteId = null;
    private string sessionToDeleteTitle = string.Empty;

    // Estado edición de título
    private int? editingSessionId = null;
    private string editTitle = string.Empty;
    private bool isSavingTitle = false;

    protected override async Task OnInitializedAsync()
    {
        SessionState.SessionsUpdated += OnSessionsUpdated;
        Sessions = await ChatService.GetChatsSessionsAsync("demo");
        StateHasChanged();
    }

    private async void OnSessionsUpdated()
    {
        Sessions = await ChatService.GetChatsSessionsAsync("demo");
        await InvokeAsync(StateHasChanged);
    }

    private void NavigateToSession(int sessionId)
    {
        SessionState.SetCurrentSession(sessionId);
        Navigation.NavigateTo($"/chat/{sessionId}");
        StateHasChanged();
    }

    private async Task ClearChat()
    {
        var newSession = await ChatService.CreateSessionAsync("demo", "Nueva Conversación");
        SessionState.SetCurrentSession(newSession.Id);
        Navigation.NavigateTo($"/chat/{newSession.Id}");
        SessionState.NotifySessionsUpdated();
    }

    // --- Edición de título ---
    private void StartEdit(int id, string currentTitle)
    {
        editingSessionId = id;
        editTitle = currentTitle;
    }

    private void CancelEdit()
    {
        editingSessionId = null;
        editTitle = string.Empty;
        isSavingTitle = false;
        StateHasChanged();
    }

    private async Task SaveTitle(int id)
    {
        if (isSavingTitle) return;

        var trimmed = (editTitle ?? string.Empty).Trim();

        var current = Sessions.FirstOrDefault(s => s.Id == id);
        if (current == null) { CancelEdit(); return; }

        if (string.IsNullOrWhiteSpace(trimmed) || trimmed == current.Title)
        {
            CancelEdit();
            return;
        }

        try
        {
            isSavingTitle = true;
            await ChatService.UpdateSessionTitleAsync(id, trimmed);
            SessionState.NotifySessionsUpdated();
        }
        finally
        {
            CancelEdit();
        }
    }

    private async Task OnTitleKeyDown(KeyboardEventArgs e, int id)
    {
        if (e.Key is "Enter")
        {
            await SaveTitle(id);
        }
        else if (e.Key is "Escape")
        {
            CancelEdit();
        }
    }

    // --- Eliminar ---
    private void OpenDeleteConfirm(int id, string title)
    {
        sessionToDeleteId = id;
        sessionToDeleteTitle = title;
        showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        sessionToDeleteId = null;
        sessionToDeleteTitle = string.Empty;
    }

    private async Task ConfirmDelete()
    {
        if (sessionToDeleteId.HasValue)
        {
            await ChatService.DeleteSessionAsync(sessionToDeleteId.Value);
            Sessions = await ChatService.GetChatsSessionsAsync("demo");

            var current = SessionState.CurrentSessionId;
            if (current == sessionToDeleteId.Value)
            {
                SessionState.SetCurrentSession(0);
                Navigation.NavigateTo("/");
            }
        }
        CancelDelete();
        StateHasChanged();
    }

    public void Dispose()
    {
        SessionState.SessionsUpdated -= OnSessionsUpdated;
    }
}

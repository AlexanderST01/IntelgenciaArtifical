@using MiChatbotBlazor.Data.Models
@using MessageModel = MiChatbotBlazor.Data.Models.ChatMessage
@using MiChatbotBlazor.Services
@inject IMarkdownService MarkdownService
@inject ITimeZoneService TimeZoneService

@if (Message.Sender == "user")
{
    <div class="message-wrapper user">
        <div class="message-content align-items-end">
            <div class="message-bubble user">
                <div class="message-text">
                    @Message.Content
                </div>
                <small class="message-time-user">
                    @TimeZoneService.FormatMessageTime(Message.Timestamp)
                </small>
            </div>
        </div>
    </div>
}
else
{
    <div class="message-wrapper bot">
        <div class="bot-message-container">
            <img src="/images/bot-avatar.png" alt="Bot" class="message-avatar" />
            <div class="message-content">
                <div class="message-bubble bot">
                    <button class="copy-btn" @onclick="() => OnCopyMessage.InvokeAsync(Message.Content)" title="Copiar mensaje">
                        <i class="bi bi-copy"></i>
                    </button>
                    <div class="message-text">
                        @((MarkupString)MarkdownService.ConvertToHtml(Message.Content))
                    </div>
                    <small class="message-time-bot">
                        @TimeZoneService.FormatMessageTime(Message.Timestamp)
                    </small>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public MessageModel Message { get; set; } = null!;
    [Parameter] public EventCallback<string> OnCopyMessage { get; set; }
}

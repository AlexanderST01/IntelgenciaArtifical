@using MiChatbotBlazor.Data.Models
@using MiChatbotBlazor.Components.Chat
@inject IChatService ChatService
@inject IAIService AIService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@inject SessionStateService SessionState

<div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
        <div class="chat-header-info">
            <!-- Botón de hamburguesa visible solo en móvil -->
            <button class="btn-hamburger d-md-none" @onclick="ToggleMobileSidebar" title="Ver conversaciones">
                <i class="bi bi-list fs-5"></i>
            </button>
            <img src="/images/bot-icon.png" alt="Bot Avatar" class="bot-header-avatar" />
            <div class="bot-header-details">
                <h5>Mi Asistente Virtual</h5>
                <div class="status-indicator">
                    <span class="status-dot @(IsOnline ? "online" : "offline")"></span>
                    <span class="text-muted">@(IsOnline ? "En línea" : "Desconectado")</span>
                </div>
            </div>
        </div>
        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" @onclick="ClearChat" title="Iniciar un nuevo chat">
            <i class="bi bi-plus-lg"></i>
            <span class="d-none d-sm-inline">Nuevo Chat</span>
        </button>
    </div>

    <!-- Área de mensajes -->
    <div class="messages-container" @ref="messagesContainer">
        <div class="chat-messages-wrapper">
            @if (messages.Count > 1 || (messages.Count == 1 && messages[0].Sender == "user"))
            {
                @foreach (var message in messages)
                {
                    <MessageItem Message="message" OnCopyMessage="CopyToClipboard" />
                }
            }
            else
            {
                <!-- Pantalla de Bienvenida (Chat vacío) -->
                <div class="welcome-screen">
                    <div class="welcome-logo-container">
                        <div class="pulse-ring"></div>
                        <img src="/images/bot-icon.png" alt="Bot Logo" class="welcome-logo" />
                    </div>
                    <h3 class="welcome-title">¿En qué puedo ayudarte hoy?</h3>
                    <p class="welcome-subtitle">Pregúntame lo que quieras o selecciona una de estas ideas:</p>
                    
                    <div class="suggestions-grid">
                        <div class="suggestion-card" @onclick='() => ClickSuggestion("Dame 3 ideas creativas para lanzar un blog sobre tecnología y productividad.")'>
                            <div class="card-icon"><i class="bi bi-lightbulb text-warning"></i></div>
                            <div class="card-content">
                                <span class="card-title">Ideas creativas</span>
                                <span class="card-desc">Lanza un blog sobre tecnología y productividad</span>
                            </div>
                        </div>
                        <div class="suggestion-card" @onclick='() => ClickSuggestion("Ayúdame a redactar un correo formal solicitando información sobre un curso de desarrollo de software.")'>
                            <div class="card-icon"><i class="bi bi-envelope text-primary"></i></div>
                            <div class="card-content">
                                <span class="card-title">Redactar correo</span>
                                <span class="card-desc">Escribe una solicitud formal para un curso</span>
                            </div>
                        </div>
                        <div class="suggestion-card" @onclick='() => ClickSuggestion("Explica cómo funciona este fragmento de código de forma sencilla:\n\n```csharp\npublic int Add(int a, int b) => a + b;\n```")'>
                            <div class="card-icon"><i class="bi bi-code-slash text-success"></i></div>
                            <div class="card-content">
                                <span class="card-title">Explicar código</span>
                                <span class="card-desc">Entiende cómo funciona una función en C#</span>
                            </div>
                        </div>
                        <div class="suggestion-card" @onclick='() => ClickSuggestion("Resume brevemente el concepto de Inteligencia Artificial Generativa y cuáles son sus usos principales.")'>
                            <div class="card-icon"><i class="bi bi-book text-danger"></i></div>
                            <div class="card-content">
                                <span class="card-title">Resumir concepto</span>
                                <span class="card-desc">Concepto y usos de la IA Generativa</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            
            @if (isLoading)
            {
                <LoadingIndicator />
            }
        </div>
    </div>

    <!-- Input de mensaje -->
    <div class="chat-input-wrapper">
        <ChatInput OnSendMessage="SendMessage" IsLoading="isLoading" />
    </div>
</div>

@code {
    [Parameter] public int SessionId { get; set; } = 0;
    
    private List<MiChatbotBlazor.Data.Models.ChatMessage> messages = new();
    private bool isLoading = false;
    private bool IsOnline => true;
    private ElementReference messagesContainer;
    private bool hasRendered = false;
    private bool shouldScrollToBottom = false;
    private int previousSessionId = 0;

    protected override async Task OnInitializedAsync()
    {
        previousSessionId = SessionId;
        await LoadMessages();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId != previousSessionId)
        {
            previousSessionId = SessionId;
            await LoadMessages();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            hasRendered = true;
        }

        if (shouldScrollToBottom && hasRendered)
        {
            shouldScrollToBottom = false;
            await ScrollToBottomSafe();
        }
    }

    private async Task LoadMessages()
    {
        var lastSesionId = SessionId > 0 ?
                        SessionId : 
                        await ChatService.GetLastSessionIdAsync("demo");

        messages = await ChatService.GetMessagesAsync(lastSesionId);
        StateHasChanged();
        RequestScrollToBottom();
    }

    private void RequestScrollToBottom()
    {
        if (hasRendered)
        {
            _ = Task.Run(async () => await ScrollToBottomSafe());
        }
        else
        {
            shouldScrollToBottom = true;
        }
    }

    private async Task ClickSuggestion(string promptText)
    {
        await SendMessage(promptText);
    }

    private void ToggleMobileSidebar()
    {
        SessionState.RequestToggleMobileSidebar();
    }

    private async Task SendMessage(string messageContent)
    {
        if (string.IsNullOrWhiteSpace(messageContent) || isLoading)
            return;

        try
        {
            isLoading = true;
            StateHasChanged();

            // Agregar mensaje del usuario
            var userMessage = await ChatService.AddMessageAsync(SessionId, messageContent, "user");
            messages.Add(userMessage);
            StateHasChanged();
            RequestScrollToBottom();

            // Preparar historial completo de conversación (últimos 10 mensajes)
            var conversationHistory = messages
                .OrderBy(m => m.Timestamp)
                .TakeLast(10)
                .Select(m => (object)new { Content = m.Content, Sender = m.Sender })
                .ToList<dynamic>();

            var aiResponse = await AIService.GetResponseAsync(messageContent, conversationHistory);

            // Agregar respuesta del bot
            var botMessage = await ChatService.AddMessageAsync(SessionId, aiResponse, "bot");
            messages.Add(botMessage);
            
            StateHasChanged();
            RequestScrollToBottom();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error enviando mensaje: {ex.Message}");
            var errorMessage = await ChatService.AddMessageAsync(SessionId, 
                "Lo siento, hubo un error al procesar tu mensaje. Por favor, intenta de nuevo.", "bot");
            messages.Add(errorMessage);
            StateHasChanged();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            RequestScrollToBottom();
        }
    }

    private async Task ClearChat()
    {
        var newSession = await ChatService.CreateSessionAsync("demo", "Nueva Conversación");
        SessionId = newSession.Id;
        await LoadMessages();

        SessionState.NotifySessionsUpdated();
    }

    private async Task CopyToClipboard(string text)
    {
        if (hasRendered && !string.IsNullOrEmpty(text))
        {
            try
            {
                var success = await JSRuntime.InvokeAsync<bool>("copyToClipboard", text);
                if (!success)
                {
                    Console.WriteLine("Falló la operación de copiado");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al copiar al portapapeles: {ex.Message}");
                await JSRuntime.InvokeVoidAsync("showCopyNotification", "Error al copiar el mensaje", true);
            }
        }
    }

    private async Task ScrollToBottomSafe()
    {
        if (hasRendered)
        {
            try
            {
                await Task.Delay(50); // Delay mínimo para render de DOM
                await JSRuntime.InvokeVoidAsync("scrollToBottom", messagesContainer);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al hacer scroll: {ex.Message}");
            }
        }
    }

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }
}

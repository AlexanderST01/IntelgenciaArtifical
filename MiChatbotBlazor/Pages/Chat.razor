@page "/chat"
@page "/chat/{sessionId:int}"
@inject SessionStateService SessionState
@inject IChatService ChatService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Chat - Mi Chatbot</PageTitle>

<div class="container-fluid h-100">
    <div class="row h-100">
        <!-- Área principal del chat -->
        <div class="col-12 p-0">
            <ChatComponent SessionId="currentSessionId" />
        </div>
    </div>
</div>

@code {
    [Parameter] public int? SessionId { get; set; }
    
    private int currentSessionId = 1;

    protected override async Task OnInitializedAsync()
    {
        // Si no hay SessionId en la URL, obtener la última sesión utilizada
        if (!SessionId.HasValue)
        {
            // Intentar obtener la última sesión del usuario
            var lastSessionId = await ChatService.GetLastSessionIdAsync("demo");
            
            if (lastSessionId > 0)
            {
                currentSessionId = lastSessionId;
                SessionState.SetCurrentSession(currentSessionId);
                
                // Navegar a la URL con el SessionId para mantener consistencia
                Navigation.NavigateTo($"/chat/{currentSessionId}", replace: true);
                return;
            }
            else
            {
                // Si no hay sesiones, crear una nueva
                var newSession = await ChatService.CreateSessionAsync("demo", "Nueva Conversación");
                currentSessionId = newSession.Id;
                SessionState.SetCurrentSession(currentSessionId);
                
                // Navegar a la nueva sesión
                Navigation.NavigateTo($"/chat/{currentSessionId}", replace: true);
                return;
            }
        }
        else
        {
            currentSessionId = SessionId.Value;
        }
        
        // Suscribirse a cambios de sesión
        SessionState.SessionChanged += OnSessionChanged;
        
        // Si hay una sesión actual en el estado, usarla
        if (SessionState.CurrentSessionId > 0 && !SessionId.HasValue)
        {
            currentSessionId = SessionState.CurrentSessionId;
        }
    }

    protected override void OnParametersSet()
    {
        if (SessionId.HasValue && SessionId.Value != currentSessionId)
        {
            currentSessionId = SessionId.Value;
            SessionState.SetCurrentSession(currentSessionId);
        }
    }

    private void OnSessionChanged(int sessionId)
    {
        currentSessionId = sessionId;
        InvokeAsync(StateHasChanged);
    }

    private void LoadSession(int sessionId)
    {
        currentSessionId = sessionId;
        SessionState.SetCurrentSession(sessionId);
        StateHasChanged();
    }

    public void Dispose()
    {
        SessionState.SessionChanged -= OnSessionChanged;
    }
}
